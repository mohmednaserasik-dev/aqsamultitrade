<div class="wrap section"><h1>{{ collection.title | escape }}</h1>{{ collection.description }}<div class="catalog"><form class="filters" method="get"><label for="Sort">{{ 'general.sort' | t }}</label><select id="Sort" name="sort_by">{% for option in collection.sort_options %}<option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>{{ option.name | escape }}</option>{% endfor %}</select>{% for filter in collection.filters %}<details><summary>{{ filter.label | escape }}</summary>{% if filter.type == 'list' or filter.type == 'boolean' %}{% for value in filter.values %}<label><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value | escape }}" {% if value.active %}checked{% endif %}> {{ value.label | escape }} ({{ value.count }})</label>{% endfor %}{% endif %}</details>{% endfor %}<button>{{ 'general.apply' | t }}</button><a href="{{ collection.url }}">{{ 'general.clear' | t }}</a></form><div>{% paginate collection.products by 24 %}<div class="grid">{% for product in collection.products %}{% render 'card', product: product %}{% endfor %}</div>{{ paginate | default_pagination }}{% endpaginate %}</div></div></div>
{% schema %}
{"name": "Main Collection", "settings": []}
{% endschema %}