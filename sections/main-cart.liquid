<div class="wrap section"><h1>{{ 'general.cart' | t }}</h1>{% if cart.empty? %}<div class="empty"><p>{{ 'general.empty' | t }}</p><a class="button" href="{{ routes.all_products_collection_url }}">{{ 'general.continue' | t }}</a></div>{% else %}<form action="{{ routes.cart_url }}" method="post">{% for item in cart.items %}<div class="cart-row"><a href="{{ item.url }}">{% if item.image %}{{ item.image | image_url: width: 150 | image_tag: loading: 'lazy' }}{% endif %}</a><div><a href="{{ item.url }}">{{ item.product.title | escape }}</a><p>{{ item.variant.title | escape }} · {{ item.final_line_price | money }}</p><a href="{{ item.url_to_remove }}">{{ 'general.remove' | t }}</a></div><input aria-label="{{ 'general.quantity' | t }}" name="updates[]" value="{{ item.quantity }}" type="number" min="0"></div>{% endfor %}<h2>{{ 'general.subtotal' | t }}: {{ cart.total_price | money }}</h2><p>{{ 'general.shipping' | t }}</p><button name="update">{{ 'general.update' | t }}</button> <button name="checkout">{{ 'general.checkout' | t }}</button></form>{% endif %}</div>
{% schema %}
{"name": "Main Cart", "settings": []}
{% endschema %}