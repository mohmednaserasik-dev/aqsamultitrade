<div class="wrap product"><div>{% for image in product.images %}<div class="photo">{{ image | image_url: width: 900 | image_tag: loading: 'lazy' }}</div>{% endfor %}</div><div><h1>{{ product.title | escape }}</h1><p class="price">{{ product.price | money }}</p>{% form 'product', product %}<label for="Variant">{{ 'general.variant' | t }}</label><select id="Variant" name="id">{% for variant in product.variants %}<option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %}>{{ variant.title | escape }} — {{ variant.price | money }}{% unless variant.available %} — {{ 'general.sold' | t }}{% endunless %}</option>{% endfor %}</select><label for="Quantity">{{ 'general.quantity' | t }}</label><input id="Quantity" type="number" name="quantity" value="1" min="1"><button {% unless product.available %}disabled{% endunless %}>{% if product.available %}{{ 'general.add' | t }}{% else %}{{ 'general.sold' | t }}{% endif %}</button>{% endform %}<div class="section">{{ product.description }}</div></div></div><script type="application/ld+json">{{ product | structured_data }}</script>
{% schema %}
{"name": "Main Product", "settings": []}
{% endschema %}