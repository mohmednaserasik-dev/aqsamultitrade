<div class="wrap"><section class="hero"><div><span class="eyebrow">{{ section.settings.kicker | escape }}</span><h1>{{ section.settings.heading | escape }}</h1><p>{{ section.settings.description | escape }}</p><a class="button" href="{{ routes.all_products_collection_url }}">{{ 'general.browse' | t }} →</a></div><div class="hero-art">{% if section.settings.image %}{{ section.settings.image | image_url: width: 900 | image_tag: widths: '450,900', sizes: '(max-width: 600px) 90vw, 45vw' }}{% else %}{% for i in (1..3) %}<div class="art">{% capture placeholder %}product-{{ i }}{% endcapture %}{{ placeholder | placeholder_svg_tag }}</div>{% endfor %}{% endif %}</div></section><section class="section"><div class="title"><h2>{{ section.settings.category_heading | escape }}</h2><a href="{{ routes.collections_url }}">{{ 'general.view' | t }} →</a></div><div class="categories">{% for collection in collections limit: 8 %}<a class="category" href="{{ collection.url }}"><div class="art">{% if collection.image %}{{ collection.image | image_url: width: 180 | image_tag: loading: 'lazy' }}{% else %}{{ 'collection-1' | placeholder_svg_tag }}{% endif %}</div>{{ collection.title | escape }}</a>{% endfor %}</div></section><section class="section"><div class="promo"><a href="{{ routes.all_products_collection_url }}"><span class="eyebrow">{{ section.settings.promo_kicker | escape }}</span><h3>{{ section.settings.promo_heading | escape }}</h3><span>{{ 'general.browse' | t }} →</span></a><a href="{{ routes.all_products_collection_url }}?sort_by=created-descending"><span class="eyebrow">{{ 'general.new' | t }}</span><h3>{{ section.settings.new_heading | escape }}</h3></a><a href="{{ routes.all_products_collection_url }}?sort_by=price-ascending"><span class="eyebrow">{{ section.settings.budget_kicker | escape }}</span><h3>{{ section.settings.budget_heading | escape }}</h3></a></div></section><section class="section"><div class="title"><h2>{{ section.settings.products_heading | escape }}</h2><a href="{{ routes.all_products_collection_url }}">{{ 'general.view' | t }} →</a></div><div class="grid">{% assign featured = section.settings.collection | default: collections.all %}{% for product in featured.products limit: 12 %}{% render 'card', product: product %}{% else %}{% for i in (1..8) %}<div class="card"><div class="photo">{{ 'product-1' | placeholder_svg_tag }}</div><div class="info"><h3>{{ 'general.demo' | t }}</h3><span class="muted">{{ 'general.sample' | t }}</span></div></div>{% endfor %}{% endfor %}</div></section></div>
{% schema %}
{"name": "Home", "settings": [{"type": "text", "id": "kicker", "label": "Kicker", "default": "YOUR EVERYDAY SHOPPING DESTINATION"}, {"type": "text", "id": "heading", "label": "Heading", "default": "Small prices. Big discoveries."}, {"type": "text", "id": "description", "label": "Description", "default": "Discover fashion, home essentials and everyday favourites \u2014 all in one place."}, {"type": "text", "id": "category_heading", "label": "Category Heading", "default": "Shop by category"}, {"type": "text", "id": "promo_kicker", "label": "Promo Kicker", "default": "HOME & EVERYDAY"}, {"type": "text", "id": "promo_heading", "label": "Promo Heading", "default": "Refresh your everyday"}, {"type": "text", "id": "new_heading", "label": "New Heading", "default": "Fresh finds, just in"}, {"type": "text", "id": "budget_kicker", "label": "Budget Kicker", "default": "VALUE PICKS"}, {"type": "text", "id": "budget_heading", "label": "Budget Heading", "default": "More for your money"}, {"type": "text", "id": "products_heading", "label": "Products Heading", "default": "Discover your next favourite"}, {"type": "image_picker", "id": "image", "label": "Hero image"}, {"type": "collection", "id": "collection", "label": "Featured collection"}]}
{% endschema %}