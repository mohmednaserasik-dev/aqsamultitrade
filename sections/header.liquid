<div class="announcement">{{ settings.announcement | escape }}</div><header><div class="wrap head"><a class="logo" href="{{ routes.root_url }}">{{ settings.brand | escape }}<small>{{ settings.tagline | escape }}</small></a><form class="search" action="{{ routes.search_url }}" method="get"><input type="hidden" name="type" value="product"><input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search' | t }}" aria-label="{{ 'general.search' | t }}"><button>{{ 'general.go' | t }}</button></form><a href="{{ routes.account_url }}">{{ 'general.account' | t }}</a><a href="{{ routes.cart_url }}">{{ 'general.cart' | t }} ({{ cart.item_count }})</a></div><nav class="wrap nav" aria-label="{{ 'general.browse' | t }}">{% for link in settings.menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% else %}<a href="{{ routes.all_products_collection_url }}">{{ 'general.browse' | t }}</a>{% endfor %}</nav></header>
{% schema %}
{"name": "Header", "settings": []}
{% endschema %}