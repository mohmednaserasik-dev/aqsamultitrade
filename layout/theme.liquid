<!doctype html><html lang="{{ request.locale.iso_code }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ page_title | escape }} | {{ shop.name | escape }}</title>{% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}<link rel="canonical" href="{{ canonical_url }}">{{ content_for_header }}{{ 'store.css' | asset_url | stylesheet_tag }}</head><body><a class="skip" href="#MainContent">{{ 'general.skip' | t }}</a>{% section 'header' %}<main id="MainContent">{{ content_for_layout }}</main>{% section 'footer' %}</body></html>